# Optional: override the public default checkpoint.
CLIP_MODEL_ID=openai/clip-vit-base-patch32

# Optional: place the local SQLite vector index somewhere else.
# IMAGE_SEARCH_DB=/absolute/path/to/index.sqlite3

# Optional: bound CPU thread count for local embedding.
# CLIP_CPU_THREADS=4

# Optional: store generated index and local uploads at a dedicated path.
# IMAGE_SEARCH_HOME=/absolute/path/to/framefind-data
